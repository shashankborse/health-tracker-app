# Copy this file to .env.local for local development.
# In production, set these as Environment Variables in the Vercel project
# dashboard instead of committing a real .env file.

# --- App auth (Phase 1) ---
# The single shared password used to log into the app.
APP_PASSWORD=
# Secret used to sign the session cookie. Can be any long random string —
# generate one with: openssl rand -hex 32
AUTH_SECRET=

# --- Supabase (Phase 1 / Phase 2) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-side only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Health API (Phase 3) ---
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
# Must exactly match the authorised redirect URI configured in Google Cloud
# Console, e.g. https://your-app.vercel.app/api/google-health/callback
GOOGLE_HEALTH_REDIRECT_URI=
# --- Google Drive (Phase 3.7+) ---
# Separate OAuth grant from Health above (same client, different redirect
# URI) — see src/lib/googleDrive.ts for why they can't share one token.
GOOGLE_DRIVE_REDIRECT_URI=

# --- Daily backup (Phase 3.9) ---
# Checked by /api/backup/run against the Authorization header Vercel Cron
# sends automatically when this is set. Generate with: openssl rand -hex 32
CRON_SECRET=
